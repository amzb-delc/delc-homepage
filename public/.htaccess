<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# http → https
# 前段に Cloudflare があり、サーバーへは常に http で届くため %{HTTPS} では判定できない。
# ブラウザ側のプロトコルは X-Forwarded-Proto ヘッダーで判定する
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule (.*) https://www.delc.jp/$1 [R=301,L]

# delc.jp → www.delc.jp
RewriteCond %{HTTP_HOST} ^delc\.jp
RewriteRule (.*) https://www.delc.jp/$1 [R=301,L]

# 末尾の index.html を取り除く
RewriteCond %{THE_REQUEST} ^.*/index.html
RewriteRule ^(.*)index.html$ https://www.delc.jp/$1 [R=301,L]
</IfModule>
